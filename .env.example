# Open-Connect frontend configuration
# Copy to .env locally. Configure production values in Cloudflare build settings.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
VITE_APP_ID=open-connect

# Unified gateway endpoints exposed to clients
VITE_OPEN_CONNECT_API_URL=https://open-connect.site/api/v1
VITE_OPEN_CONNECT_MCP_URL=https://open-connect.site/mcp
VITE_OPEN_CONNECT_MODEL_URL=https://open-connect.site/v1
